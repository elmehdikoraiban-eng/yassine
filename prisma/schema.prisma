// Modèle de données — Plateforme de gestion du cabinet d'architecture
// Lots 1 (socle), 2 (documents) et 3 (finances).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GERANT
  ASSISTANTE
  TECHNICIEN
  COLLABORATEUR
}

enum ClientType {
  PHYSIQUE
  MORALE
}

enum NoteKind {
  APPEL
  REUNION
  EMAIL
  DEMANDE
  OBSERVATION
}

enum ProjectStatus {
  EN_COURS
  SUSPENDU
  CLOTURE
  ARCHIVE
}

enum StakeholderKind {
  BET
  ENTREPRISE
  BUREAU_CONTROLE
  LABORATOIRE
  TOPOGRAPHE
  AUTRE
}

enum DocState {
  TRAVAIL
  VALIDE
  OBSOLETE
}

enum PlanStatus {
  A_PREPARER
  EN_COURS
  A_VERIFIER
  VALIDE
  DIFFUSE
  REVISE
}

enum InvoiceStatus {
  BROUILLON
  EMISE
  ANNULEE
}

enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
}

enum PaymentMethod {
  VIREMENT
  CHEQUE
  ESPECES
  EFFET
  AUTRE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  memberships   ProjectMember[]
  versions      DocumentVersion[]
  notes         ClientNote[]
  audits        AuditLog[]
  notifications Notification[]
}

/// Informations du cabinet utilisées sur les factures (ligne unique, id = 1).
model Settings {
  id           Int     @id @default(1)
  name         String  @default("Cabinet d'architecture")
  address      String  @default("")
  city         String  @default("")
  phone        String  @default("")
  email        String  @default("")
  ice          String  @default("")
  ifiscal      String  @default("")
  rc           String  @default("")
  patente      String  @default("")
  cnss         String  @default("")
  rib          String  @default("")
  vatRate      Decimal @default(20) @db.Decimal(5, 2)
  paymentDays  Int     @default(30)
  /// Identité visuelle : logo et favicon téléversés (chemin de stockage), pastille affichée ou non.
  appName      String  @default("Cabinet")
  logoPath     String?
  logoMime     String?
  faviconPath  String?
  faviconMime  String?
  showMark     Boolean @default(true)
  brandVersion Int     @default(0)
}

/// Notification interne (cloche dans l'application) : affectation à un projet, nouveau dossier…
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Client {
  id        String     @id @default(cuid())
  type      ClientType @default(PHYSIQUE)
  name      String
  contact   String?
  cin       String?
  ice       String?
  rc        String?
  ifiscal   String?
  address   String?
  city      String?
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime   @default(now())

  projects     Project[]
  interactions ClientNote[]
  quotes       Quote[]
}

model ClientNote {
  id       String   @id @default(cuid())
  clientId String
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId String
  author   User     @relation(fields: [authorId], references: [id])
  kind     NoteKind
  content  String
  date     DateTime @default(now())

  @@index([clientId, date])
}

model Project {
  id                String        @id @default(cuid())
  reference         String        @unique
  name              String
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id])
  location          String?
  city              String?
  nature            String?
  programme         String?
  landTitle         String?
  surfaceTerrain    Decimal?      @db.Decimal(12, 2)
  surfaceConstruite Decimal?      @db.Decimal(12, 2)
  step              Int           @default(1)
  status            ProjectStatus @default(EN_COURS)
  startDate         DateTime      @default(now())
  createdAt         DateTime      @default(now())

  members      ProjectMember[]
  stakeholders ProjectStakeholder[]
  documents    Document[]
  contract     Contract?
  invoices     Invoice[]
  stepChanges  StepChange[]
  quotes       Quote[]

  @@index([clientId])
  @@index([status, createdAt])
}

model ProjectMember {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model StepChange {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStep  Int
  toStep    Int
  userName  String
  comment   String?
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Stakeholder {
  id        String          @id @default(cuid())
  kind      StakeholderKind
  name      String
  contact   String?
  phone     String?
  email     String?
  createdAt DateTime        @default(now())

  projects      ProjectStakeholder[]
  distributions Distribution[]
}

model ProjectStakeholder {
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  mission       String?

  @@id([projectId, stakeholderId])
  @@index([stakeholderId])
}

model Document {
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder     String
  title      String
  isPlan     Boolean     @default(false)
  planCode   String?
  planStatus PlanStatus?
  state      DocState    @default(TRAVAIL)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  versions      DocumentVersion[]
  distributions Distribution[]

  @@index([projectId, updatedAt])
  @@index([planStatus])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index       String
  fileName    String
  storagePath String
  size        Int
  mime        String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  comment     String?
  createdAt   DateTime @default(now())

  distributions Distribution[]

  @@index([documentId, createdAt])
}

model Distribution {
  id            String          @id @default(cuid())
  documentId    String
  document      Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId     String
  version       DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  stakeholderId String?
  stakeholder   Stakeholder?    @relation(fields: [stakeholderId], references: [id])
  recipient     String?
  note          String?
  userName      String
  date          DateTime        @default(now())

  @@index([documentId])
  @@index([stakeholderId])
}

model Contract {
  id        String    @id @default(cuid())
  projectId String    @unique
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amountHT  Decimal   @db.Decimal(14, 2)
  vatRate   Decimal   @default(20) @db.Decimal(5, 2)
  signedAt  DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  milestones Milestone[]
}

model Milestone {
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  order      Int
  label      String
  percent    Decimal   @db.Decimal(6, 2)
  step       Int?
  dueDate    DateTime?

  invoices Invoice[]

  @@index([contractId])
}

model Invoice {
  id           String        @id @default(cuid())
  number       String?       @unique
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  milestoneId  String?
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id])
  object       String
  amountHT     Decimal       @db.Decimal(14, 2)
  vatRate      Decimal       @db.Decimal(5, 2)
  status       InvoiceStatus @default(BROUILLON)
  issueDate    DateTime?
  dueDate      DateTime?
  cancelReason String?
  createdAt    DateTime      @default(now())

  payments  Payment[]
  reminders Reminder[]

  @@index([projectId])
  @@index([status, dueDate])
  @@index([milestoneId])
}

model Payment {
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  reference String?
  userName  String
  createdAt DateTime      @default(now())

  @@index([invoiceId])
}

model Reminder {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  channel   String
  note      String?
  userName  String

  @@index([invoiceId])
}

/// Devis d'honoraires adressé à un client, transformable en projet avec contrat une fois accepté.
model Quote {
  id         String      @id @default(cuid())
  number     String      @unique
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  object     String
  status     QuoteStatus @default(BROUILLON)
  issueDate  DateTime    @default(now())
  validUntil DateTime?
  vatRate    Decimal     @default(20) @db.Decimal(5, 2)
  notes      String?
  createdAt  DateTime    @default(now())

  lines QuoteLine[]

  @@index([clientId])
  @@index([status, createdAt])
}

model QuoteLine {
  id        String  @id @default(cuid())
  quoteId   String
  quote     Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order     Int
  label     String
  quantity  Decimal @default(1) @db.Decimal(12, 2)
  unit      String?
  unitPrice Decimal @db.Decimal(14, 2)

  @@index([quoteId])
}

/// Numérotation légale continue des factures, par année.
model Counter {
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  projectId String?
  action    String
  summary   String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}

// Modèle de données — Plateforme de gestion du cabinet d'architecture
// Lots 1 (socle), 2 (documents) et 3 (finances).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("SUPABASE_DATABASE_URL")
  directUrl = env("SUPABASE_DIRECT_URL")
}

enum Role {
  GERANT
  ASSISTANTE
  TECHNICIEN
  COLLABORATEUR
}

enum ClientType {
  PHYSIQUE
  MORALE
}

enum NoteKind {
  APPEL
  REUNION
  EMAIL
  DEMANDE
  OBSERVATION
}

enum ProjectStatus {
  EN_COURS
  SUSPENDU
  CLOTURE
  ARCHIVE
}

enum StakeholderKind {
  BET
  ENTREPRISE
  BUREAU_CONTROLE
  LABORATOIRE
  TOPOGRAPHE
  AUTRE
}

enum DocState {
  TRAVAIL
  VALIDE
  OBSOLETE
}

enum PlanStatus {
  A_PREPARER
  EN_COURS
  A_VERIFIER
  VALIDE
  DIFFUSE
  REVISE
}

enum InvoiceStatus {
  BROUILLON
  EMISE
  ANNULEE
}

enum QuoteStatus {
  BROUILLON
  ENVOYE
  ACCEPTE
  REFUSE
}

enum PaymentMethod {
  VIREMENT
  CHEQUE
  ESPECES
  EFFET
  AUTRE
}

/// Organisation cliente de la plateforme SaaS.
model Cabinet {
  id                 String    @id @default(cuid())
  name               String
  slug               String    @unique
  city               String?
  phone              String?
  contactEmail       String?
  status             String    @default("ACTIVE")
  plan               String    @default("TRIAL")
  subscriptionStatus String    @default("TRIAL")
  trialEndsAt        DateTime?
  subscriptionStartedAt DateTime?
  subscriptionRenewsAt DateTime?
  lastPaymentAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  users               User[]
  settings            Settings?
  notifications       Notification[]
  clients             Client[]
  clientNotes         ClientNote[]
  projects            Project[]
  projectMembers      ProjectMember[]
  stepChanges         StepChange[]
  stakeholders        Stakeholder[]
  stakeholderFiles    StakeholderFile[]
  projectStakeholders ProjectStakeholder[]
  documents           Document[]
  documentVersions    DocumentVersion[]
  distributions       Distribution[]
  contracts           Contract[]
  milestones          Milestone[]
  invoices            Invoice[]
  payments            Payment[]
  reminders           Reminder[]
  quotes              Quote[]
  quoteLines          QuoteLine[]
  counters            Counter[]
  auditLogs           AuditLog[]

  @@index([status, createdAt])
}

model User {
  cabinetId    String
  cabinet      Cabinet  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  lastLoginAt  DateTime?

  memberships      ProjectMember[]
  versions         DocumentVersion[]
  stakeholderFiles StakeholderFile[]
  notes            ClientNote[]
  audits           AuditLog[]
  notifications    Notification[]
}

/// Informations du cabinet utilisées sur les factures.
model Settings {
  id           Int     @id @default(autoincrement())
  cabinetId    String  @unique
  cabinet      Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  name         String  @default("Cabinet d'architecture")
  address      String  @default("")
  city         String  @default("")
  phone        String  @default("")
  email        String  @default("")
  ice          String  @default("")
  ifiscal      String  @default("")
  rc           String  @default("")
  patente      String  @default("")
  cnss         String  @default("")
  rib          String  @default("")
  vatRate      Decimal @default(20) @db.Decimal(5, 2)
  paymentDays  Int     @default(30)
  /// Identité visuelle : logo et favicon téléversés (chemin de stockage), pastille affichée ou non.
  appName      String  @default("Cabinet")
  logoPath     String?
  logoMime     String?
  faviconPath  String?
  faviconMime  String?
  showMark     Boolean @default(true)
  brandVersion Int     @default(0)
}

/// Notification interne (cloche dans l'application) : affectation à un projet, nouveau dossier…
model Notification {
  cabinetId String?
  cabinet   Cabinet?  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  href      String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([cabinetId])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Client {
  cabinetId     String?
  cabinet       Cabinet?   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id            String     @id @default(cuid())
  type          ClientType @default(PHYSIQUE)
  name          String
  contact       String?
  cin           String?
  cinExpiryDate DateTime?
  fatherName    String?
  motherName    String?
  ice           String?
  rc            String?
  ifiscal       String?
  address       String?
  city          String?
  phone         String?
  email         String?
  notes         String?
  createdAt     DateTime   @default(now())

  projects     Project[]
  interactions ClientNote[]
  quotes       Quote[]
}

model ClientNote {
  cabinetId String?
  cabinet   Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  kind      NoteKind
  content   String
  date      DateTime @default(now())

  @@index([cabinetId])
  @@index([clientId, date])
}

model Project {
  cabinetId           String?
  cabinet             Cabinet?      @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id                  String        @id @default(cuid())
  reference           String
  name                String
  clientId            String
  client              Client        @relation(fields: [clientId], references: [id])
  location            String?
  city                String?
  nature              String?
  programme           String?
  landTitle           String?
  technicianObjective String?
  surfaceTerrain      Decimal?      @db.Decimal(12, 2)
  surfaceConstruite   Decimal?      @db.Decimal(12, 2)
  step                Int           @default(1)
  status              ProjectStatus @default(EN_COURS)
  startDate           DateTime      @default(now())
  createdAt           DateTime      @default(now())

  members      ProjectMember[]
  stakeholders ProjectStakeholder[]
  documents    Document[]
  contract     Contract?
  invoices     Invoice[]
  stepChanges  StepChange[]
  quotes       Quote[]

  @@unique([cabinetId, reference])
  @@index([cabinetId])
  @@index([clientId])
  @@index([status, createdAt])
}

model ProjectMember {
  cabinetId String?
  cabinet   Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([cabinetId])
  @@index([userId])
}

model StepChange {
  cabinetId String?
  cabinet   Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromStep  Int
  toStep    Int
  userName  String
  comment   String?
  createdAt DateTime @default(now())

  @@index([cabinetId])
  @@index([projectId, createdAt])
}

model Stakeholder {
  cabinetId String?
  cabinet   Cabinet?        @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String          @id @default(cuid())
  kind      StakeholderKind
  name      String
  contact   String?
  phone     String?
  email     String?
  createdAt DateTime        @default(now())

  projects      ProjectStakeholder[]
  distributions Distribution[]
  files         StakeholderFile[]
}

/// Fichiers privés reçus ou partagés avec un intervenant.
model StakeholderFile {
  cabinetId     String
  cabinet       Cabinet     @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id            String      @id @default(cuid())
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id], onDelete: Restrict)
  fileName      String
  storagePath   String
  size          Int
  mime          String
  createdAt     DateTime    @default(now())

  @@index([cabinetId])
  @@index([stakeholderId, createdAt])
  @@index([authorId])
}

model ProjectStakeholder {
  cabinetId     String?
  cabinet       Cabinet?    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stakeholderId String
  stakeholder   Stakeholder @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  mission       String?

  @@id([projectId, stakeholderId])
  @@index([cabinetId])
  @@index([stakeholderId])
}

model Document {
  cabinetId  String?
  cabinet    Cabinet?    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id         String      @id @default(cuid())
  projectId  String
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder     String
  title      String
  isPlan     Boolean     @default(false)
  planCode   String?
  planStatus PlanStatus?
  state      DocState    @default(TRAVAIL)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  versions      DocumentVersion[]
  distributions Distribution[]

  @@index([cabinetId])
  @@index([projectId, updatedAt])
  @@index([planStatus])
}

model DocumentVersion {
  cabinetId   String?
  cabinet     Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  index       String
  fileName    String
  storagePath String
  size        Int
  mime        String
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  comment     String?
  createdAt   DateTime @default(now())

  distributions Distribution[]

  @@index([cabinetId])
  @@index([documentId, createdAt])
}

model Distribution {
  cabinetId     String?
  cabinet       Cabinet?        @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id            String          @id @default(cuid())
  documentId    String
  document      Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId     String
  version       DocumentVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  stakeholderId String?
  stakeholder   Stakeholder?    @relation(fields: [stakeholderId], references: [id])
  recipient     String?
  note          String?
  userName      String
  date          DateTime        @default(now())

  @@index([cabinetId])
  @@index([documentId])
  @@index([stakeholderId])
}

model Contract {
  cabinetId String?
  cabinet   Cabinet?  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String    @id @default(cuid())
  projectId String    @unique
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amountHT  Decimal   @db.Decimal(14, 2)
  vatRate   Decimal   @default(20) @db.Decimal(5, 2)
  signedAt  DateTime?
  notes     String?
  createdAt DateTime  @default(now())

  milestones Milestone[]
}

model Milestone {
  cabinetId  String?
  cabinet    Cabinet?  @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id         String    @id @default(cuid())
  contractId String
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  order      Int
  label      String
  percent    Decimal   @db.Decimal(6, 2)
  step       Int?
  dueDate    DateTime?

  invoices Invoice[]

  @@index([cabinetId])
  @@index([contractId])
}

model Invoice {
  cabinetId    String?
  cabinet      Cabinet?      @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id           String        @id @default(cuid())
  number       String?
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  milestoneId  String?
  milestone    Milestone?    @relation(fields: [milestoneId], references: [id])
  object       String
  amountHT     Decimal       @db.Decimal(14, 2)
  vatRate      Decimal       @db.Decimal(5, 2)
  status       InvoiceStatus @default(BROUILLON)
  issueDate    DateTime?
  dueDate      DateTime?
  cancelReason String?
  createdAt    DateTime      @default(now())

  payments  Payment[]
  reminders Reminder[]

  @@unique([cabinetId, number])
  @@index([cabinetId])
  @@index([projectId])
  @@index([status, dueDate])
  @@index([milestoneId])
}

model Payment {
  cabinetId String?
  cabinet   Cabinet?      @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String        @id @default(cuid())
  invoiceId String
  invoice   Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    Decimal       @db.Decimal(14, 2)
  method    PaymentMethod
  reference String?
  userName  String
  createdAt DateTime      @default(now())

  @@index([cabinetId])
  @@index([invoiceId])
}

model Reminder {
  cabinetId String?
  cabinet   Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  channel   String
  note      String?
  userName  String

  @@index([cabinetId])
  @@index([invoiceId])
}

/// Devis d'honoraires adressé à un client, transformable en projet avec contrat une fois accepté.
model Quote {
  cabinetId  String?
  cabinet    Cabinet?    @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id         String      @id @default(cuid())
  number     String
  clientId   String
  client     Client      @relation(fields: [clientId], references: [id])
  projectId  String?
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  object     String
  status     QuoteStatus @default(BROUILLON)
  issueDate  DateTime    @default(now())
  validUntil DateTime?
  vatRate    Decimal     @default(20) @db.Decimal(5, 2)
  notes      String?
  createdAt  DateTime    @default(now())

  lines QuoteLine[]

  @@unique([cabinetId, number])
  @@index([cabinetId])
  @@index([clientId])
  @@index([status, createdAt])
}

model QuoteLine {
  cabinetId String?
  cabinet   Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order     Int
  label     String
  quantity  Decimal  @default(1) @db.Decimal(12, 2)
  unit      String?
  unitPrice Decimal  @db.Decimal(14, 2)

  @@index([cabinetId])
  @@index([quoteId])
}

/// Numérotation légale continue des factures, par année.
model Counter {
  cabinetId String
  cabinet   Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  key       String
  value     Int     @default(0)

  @@id([cabinetId, key])
}

model AuditLog {
  cabinetId String?
  cabinet   Cabinet? @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String
  entityId  String
  projectId String?
  action    String
  summary   String
  createdAt DateTime @default(now())

  @@index([cabinetId])
  @@index([projectId])
  @@index([createdAt])
}


/// Historique distinct des actions réalisées depuis l'administration plateforme.
model PlatformAdminAction {
  id         String   @id @default(cuid())
  adminId    String
  adminEmail String
  cabinetId  String?
  action     String
  summary    String
  createdAt  DateTime @default(now())

  @@index([cabinetId, createdAt])
  @@index([adminId, createdAt])
}

